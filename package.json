{
  "name": "tablefacts",
  "version": "0.3.0",
  "description": "Data extraction tools for restaurant sites: public-facts research, photos (Instagram, TripAdvisor) and menu import from Cluvi, pictures or PDFs",
  "keywords": [
    "restaurant",
    "menu",
    "pdf",
    "scraper",
    "tripadvisor",
    "instagram",
    "supabase",
    "cli"
  ],
  "license": "MIT",
  "author": "Mateo Arias",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MateoAriasCaicedo/tablefacts.git"
  },
  "bugs": {
    "url": "https://github.com/MateoAriasCaicedo/tablefacts/issues"
  },
  "homepage": "https://github.com/MateoAriasCaicedo/tablefacts#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./src/index.mjs",
  "types": "./types/index.d.mts",
  "bin": {
    "tablefacts": "bin/tablefacts.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./edge": {
      "types": "./types/lib/edge.d.mts",
      "default": "./src/lib/edge.mjs"
    },
    "./project": {
      "types": "./types/lib/project.d.mts",
      "default": "./src/lib/project.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "types",
    ".env.example",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run",
    "build:types": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build:types && npm test"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@types/node": "^26.6.4",
    "pdfjs-dist": "~6.2.108",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "pdfjs-dist": "~6.2.108",
    "playwright": "^1.63.0"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  }
}
