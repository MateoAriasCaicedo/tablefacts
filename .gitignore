# Dependencies
node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# env files: never commit one, but keep the example
.env*
!.env.example

# Build output (generated by `npm run build:types`)
types/
dist/
build/
*.tsbuildinfo

# Output, caches and browser profiles of a run
.tablefacts/
.extract/

# Packed tarballs (`npm pack`)
*.tgz

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and coverage output
coverage/
.nyc_output/
.vitest/
test-results/
playwright-report/

# Tool caches
.cache/
.eslintcache
.npm/
.node_repl_history

# Editors and IDEs (shared settings stay tracked)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Operating systems
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Local-only Claude Code settings
.claude/settings.local.json
