# Supabase > Connect > Session pooler (this tool holds one connection and reads information_schema).
# Bypasses row level security: keep it here, never in a browser-exposed variable.
SUPABASE_DB_URL=SUPABASE_DB_POOLER_URL

# Menus that are only pictures (tablefacts menu raw) are read by a vision model. Fill in
# the key of the provider you use: Claude, Gemini or Groq
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Which one reads them when --provider is not given: anthropic (the default), gemini or groq
MENU_VISION_PROVIDER=

# Restaurant research (tablefacts research) reads Google Maps through the Places API (New).
# Optional: without it OpenStreetMap and the web pages still work, with fewer facts.
GOOGLE_PLACES_API_KEY=
